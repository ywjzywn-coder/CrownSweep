{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrownSweep",
  "version": "0.4.0",
  "identifier": "com.ellaycrown.molegui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CrownSweep",
        "width": 1160,
        "height": 760,
        "minWidth": 940,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/mole-smc"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBQTFGMzlBRDYxODlDRDUKUldUVm5Caldtdk9oT3VtUnVWS0VEQ3p3UDZmM05CMHZnK2lCM1dWdzlxcmZyOFVCdEhzTXZCcGIK",
      "requireSignedVersion": true
    }
  }
}
